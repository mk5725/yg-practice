<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.exam.mapper.ExamSendMapper">

    <!-- 查询考试发放列表 -->
    <select id="selectExamSendPage" parameterType="com.ruoyi.exam.domain.bo.ExamSendBo" resultType="com.ruoyi.exam.domain.vo.ExamSendVo">
        select s.id,
        p.id paperId,
        p.paper_name,
        p.pass_score,
        p.total_score,
        s.duration,
        s.start_time,
        s.end_time,
        s.create_time,
        s.create_user_id
        from exam_send s
        join exam_paper p on s.paper_id = p.id
        where s.del_flag = '0'
        <if test="bo.paperName != null and bo.paperName != ''">
            and p.paper_name like CONCAT('%', #{bo.paperName} , '%')
        </if>
        <if test="bo.status != null">
            and s.status = #{bo.status}
        </if>
        order by s.create_time desc
    </select>

    <resultMap type="com.ruoyi.exam.domain.ExamSend" id="ExamSendResult">
        <result property="id" column="id"/>
        <result property="paperId" column="paper_id"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="duration" column="duration"/>
        <result property="updateTime" column="update_time"/>
        <result property="createUserId" column="create_user_id"/>
        <result property="updateUserId" column="update_user_id"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

</mapper>
